# Google AI Studio API Key (Leave empty to run in Demonstration Mode)
GOOGLE_API_KEY=

# Gemma Model Selection:
# - gemma-4-26b-a4b-it (Mixture of Experts, fast, default)
# - gemma-4-31b-it     (Dense, 31B parameters, more capable, slower)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Server configuration
HOST=0.0.0.0
PORT=8000
